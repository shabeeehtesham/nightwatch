# Free key from https://aisstream.io (sign in with GitHub). Without it the
# ships layer and chokepoint counts stay offline; everything else still works.
AISSTREAM_API_KEY=

# Free key from https://api.windy.com (Webcams API). Adds worldwide webcams to
# the CCTV layer; London + California traffic cameras work without it.
WINDY_API_KEY=
